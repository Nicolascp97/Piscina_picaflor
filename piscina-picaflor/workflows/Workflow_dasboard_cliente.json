    {
      "parameters": {
        "jsCode": "// Verificar que encontró el usuario\nconst userItems = $items(\"Buscar Usuario\");\n\nif (!userItems || userItems.length === 0 || !userItems[0].json.id) {\n  return {\n    success: false,\n    error: \"Usuario no encontrado\"\n  };\n}\n\nconst user = userItems[0].json;\n\n// Procesar historial (si existe)\nlet historial = [];\ntry {\n  const historyItems = $items(\"Buscar Historial\");\n  if (historyItems && historyItems.length > 0 && historyItems[0].json.id) {\n    historial = historyItems\n      .filter(h => h.json.Fecha) // Solo items válidos\n      .map(h => ({\n        id: h.json.id,\n        fecha: h.json.Fecha || \"Reciente\",\n        actividad: h.json[\"Descripción\"] || h.json[\"Tipo de Evento\"] || \"Movimiento\",\n        puntos: parseInt(h.json.Puntos) || 0\n      }));\n  }\n} catch (e) {\n  console.log(\"Error procesando historial:\", e);\n  historial = [];\n}\n\n// Limpiar código (remover comillas extras)\nconst codigoLimpio = String(user.Codigo || '').replace(/[\"']/g, '').trim();\n\n// Estructura final JSON\nreturn {\n  success: true,\n  data: {\n    nombre: user.Nombre || \"Usuario\",\n    codigo: codigoLimpio,\n    puntos: parseInt(user.Puntos) || 0,\n    email: user.Email || \"\",\n    historial: historial,\n    premios: [] // Premios vacíos - se manejan en frontend\n  }\n};"
      },
