---
import Base from '../layouts/Base.astro';
---
<Base titulo="Validar Pase | Piscina Picaflor" descripcion="Verificación de un Pase de Apertura." noindex={true} barra={false}>
  <main class="mx-auto max-w-md px-5 py-10">
    <p class="text-center text-sm font-semibold uppercase tracking-widest text-oceano-700">Piscina Picaflor · Pase de Apertura</p>
    <p id="v-codigo" class="mt-2 text-center font-mono text-3xl font-black tracking-wider"></p>
    <div id="veredicto" class="mt-6 rounded-3xl bg-slate-600 px-6 py-10 text-center text-white" role="status" aria-live="polite">
      <p id="v-titulo" class="text-5xl font-black">...</p>
      <p id="v-nombre" class="mt-4 text-2xl font-bold"></p>
      <p id="v-detalle" class="mt-2 text-lg"></p>
    </div>
    <p id="v-nota" class="mt-5 text-center text-base text-oceano-900/85"></p>
  </main>
  <script>
    import '../scripts/verificar.ts';
  </script>
</Base>
