---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PaseForm from '../components/PaseForm.astro';
import Incluye from '../components/Incluye.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Galeria from '../components/Galeria.astro';
import PruebaSocial from '../components/PruebaSocial.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Faq from '../components/Faq.astro';
import Cierre from '../components/Cierre.astro';
import Footer from '../components/Footer.astro';
import HeroAvance from '../components/HeroAvance.astro';
import { avance } from '../lib/config';
---
<Base barra={!avance} titulo={avance ? "Abrimos el 20 | Piscina Picaflor, Litueche" : "Abrimos el 20 · Pase de Apertura | Piscina Picaflor, Litueche"} descripcion={avance ? "Arriendo de piscina por día en Litueche. Abrimos el 20 de noviembre." : "Arrienda la piscina completa por el día en Litueche. Saca tu Pase de Apertura gratis y reserva con descuento por WhatsApp."}>
  <main>
    {avance ? <HeroAvance /> : (<>
    <Hero />
    <PaseForm />
    <Incluye />
    <ComoFunciona />
    <Galeria />
    <PruebaSocial />
    <Ubicacion />
    <Faq />
    <Cierre />
    </>)}
  </main>
  <Footer />
</Base>
