---
import '../styles/global.css';
import { config, datosCliente, waLink, wspDigitos } from '../lib/config';
import BarraMovil from '../components/BarraMovil.astro';
const { titulo, descripcion, noindex = false, barra = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const datos = JSON.stringify(datosCliente()).replace(/</g, '\u003c');
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#0a3a4a" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <div id="aviso-fidelidad" hidden class="bg-sol-400 px-5 py-3 text-center text-base font-semibold text-oceano-950">
      {config.textos.aviso_fidelidad}
      {wspDigitos() && <a href={waLink(config.whatsapp_mensajes.general)} data-wsp="aviso" class="underline">{config.textos.whatsapp.boton}</a>}
    </div>
    <slot />
    {barra && <BarraMovil />}
    {wspDigitos() && <noscript>
      <p class="px-5 py-6 text-center text-lg">Para sacar tu Pase necesitas activar JavaScript. Mientras tanto, <a class="font-bold underline" href={waLink(config.whatsapp_mensajes.general)}>escríbenos por WhatsApp</a>.</p>
    </noscript>}
    <script id="pase-datos" type="application/json" set:html={datos} />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
