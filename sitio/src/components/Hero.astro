---
import { Picture } from 'astro:assets';
import { config, waLink } from '../lib/config';
import { foto } from '../lib/fotos';
import Dato from './Dato.astro';
const H = config.textos.hero;
const img = foto('hero');
---
<section class="relative isolate overflow-hidden bg-oceano-950 text-white">
  {img ? (
    <>
      <Picture src={img} formats={['avif', 'webp']} widths={[480, 768, 1080]} sizes="100vw" alt={H.alt_foto} loading="eager" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-oceano-950/70 via-oceano-900/55 to-oceano-950/85"></div>
    </>
  ) : (
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-oceano-950 via-oceano-900 to-oceano-700"></div>
  )}
  <div class="mx-auto flex min-h-[88svh] max-w-3xl flex-col justify-center px-5 py-10 sm:py-16">
    <p class="mb-4 inline-flex w-fit items-center rounded-full bg-white/12 px-3 py-1.5 text-sm text-turquesa-300 ring-1 ring-white/20">{H.talla}</p>
    <p class="text-sm font-semibold uppercase tracking-widest text-turquesa-300">{config.negocio.nombre} · {config.negocio.comuna}</p>
    <h1 class="mt-2 text-5xl font-extrabold leading-[1.02] sm:text-7xl">{H.titular}</h1>
    <p class="mt-4 max-w-xl text-lg text-white/90 sm:text-xl">{H.bajada}</p>
    <p class="mt-5 inline-flex w-fit flex-wrap items-center gap-x-2 rounded-2xl bg-sol-400 px-4 py-2 text-base font-extrabold text-oceano-950">
      <span>Pase de Apertura</span><span aria-hidden="true">·</span><span><Dato v={config.pase.descuento_texto} /></span>
    </p>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a href="#pase" data-cta="hero" class="inline-flex min-h-14 items-center justify-center rounded-full bg-sol-400 px-8 text-lg font-extrabold text-oceano-950 shadow-lg transition hover:bg-sol-500">{H.cta}</a>
      <a href={waLink(config.whatsapp_mensajes.general)} data-wsp="hero" class="inline-flex min-h-12 items-center justify-center rounded-full px-5 text-base font-semibold text-white underline decoration-turquesa-300 underline-offset-4">{config.textos.whatsapp.boton}</a>
    </div>
    <p class="mt-3 text-sm text-white/75">{H.microcopy}</p>
  </div>
</section>
