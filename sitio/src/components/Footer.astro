---
import { config, avance } from '../lib/config';
const ig = config.negocio.instagram;
---
<footer class="bg-oceano-950 px-5 pb-28 pt-10 text-center text-white/80 sm:pb-12">
  <p class="text-lg font-bold text-white">{config.negocio.nombre}</p>
  <p class="mt-1">Sector {config.negocio.sector}, {config.negocio.comuna} · {config.negocio.region}</p>
  <p class="mt-3"><a class="underline" href={'https://instagram.com/' + ig} rel="noopener" target="_blank">@{ig}</a>{!avance && <> · <a class="underline" href="/privacidad/">{config.textos.footer.privacidad}</a></>}</p>
  <p class="mt-4 text-sm text-white/60">{config.textos.footer.legal}</p>
</footer>
